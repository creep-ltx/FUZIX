umask 022
# The console font and keymap chosen with fontprefs and keymap
fontprefs -l 2>/dev/null
keymap -l 2>/dev/null
# Repairs without asking (fsck.yes answers y): an Amiga switched off
# without a shutdown still comes up on its own
fsck -a / </etc/fsck.yes
setdate
remount -n / rw
prtroot >/etc/mtab
#Uncomment if you have multiple file systems
#fsck -a
#mount -a
>/var/run/utmp
# Offer to install on the hard disk, or the Extras disks
setup -boot 2>/dev/null
