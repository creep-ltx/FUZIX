# Amiga-only programs (68000 builds only)
include $(FUZIX_ROOT)/Target/rules.68000

APPS = keymap

all: $(APPS) setup amigaread keymaps

$(APPS): %: %.o
	$(LINKER) $(CRT0) $^ -o $@ $(LINKER_OPT) $(LINKER_TAIL)

# setup reads partition tables and copies trees: 32K, not the 8K default
setup: setup.o
	$(LINKER) $(CRT0) $^ -o $@ -s 32768 $(LINKER_OPT) $(LINKER_TAIL)

# AmigaDOS disks (adf.c is CFile's reader). 128K for directory listings.
amigaread: amigaread.o adf.o
	$(LINKER) $(CRT0) $^ -o $@ -s 131072 $(LINKER_OPT) $(LINKER_TAIL)

# Keymaps: free ones made from the X keyboard layouts (xkeyboard-config,
# MIT licence; needs libxkbcommon and the layouts installed, as on any
# Linux desktop), shipped on the disks with their notice.
#
# For your own use only: AMIGA_KEYMAPS=<a Devs/Keymaps folder of your own
# Workbench> converts the AmigaOS originals instead. Those are Commodore/
# Hyperion files: images built that way must not be given to others.
PLAT = $(FUZIX_ROOT)/Kernel/platform/platform-amiga
.PHONY: keymaps
keymaps:
	rm -rf keymaps
	if [ -n "$(AMIGA_KEYMAPS)" ]; then \
		python3 $(PLAT)/mkkeymap.py --pkg fuzix-amigakeymaps.pkg keymaps \
			$$(ls "$(AMIGA_KEYMAPS)"/* | grep -v -e '\.info' -e '\.uaem'); \
	else \
		python3 $(PLAT)/mkxkbkeymap.py --pkg fuzix-amigakeymaps.pkg keymaps; \
	fi

clean:
	rm -f *.o $(APPS) setup amigaread
	rm -rf keymaps fuzix-amigakeymaps.pkg
